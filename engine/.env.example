APP_ENV=development

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

QDRANT_COLLECTION=anahat_knowledge

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

CHUNK_SIZE=800
CHUNK_MAX_SIZE=1000
CHUNK_OVERLAP=120

RETRIEVAL_TOP_K=10

KB_PATH=./knowledge_base/ANAHAT_KnowledgeBase_v3

LLM_PROVIDER=mistral
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=llama3:latest
LOCAL_LLM_KEEP_ALIVE=30m
LLM_FALLBACK_PROVIDERS=local
# Mistral (OpenAI-compatible API). Choose a model id from your Mistral console that supports structured output.
MISTRAL_API_KEY=
MISTRAL_MODEL=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
LLM_REQUEST_TIMEOUT_SECONDS=90
LLM_TOTAL_TIMEOUT_SECONDS=180
